# API配置环境变量模板
# 将此文件复制为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制

# ==========================================
# OpenAI 配置
# ==========================================
OPENAI_API_KEY=sk-your_key_here
OPENAI_BASE_URL=https://api.openai.com/
OPENAI_MODEL=gpt-4-turbo

# ==========================================
# OpenAI 代理服务配置 (可选)
# ==========================================
OPENAI_PROXY_API_KEY=sk-your_proxy_key_here
OPENAI_PROXY_BASE_URL=https://your-proxy-service.com/
OPENAI_PROXY_MODEL=gpt-4-turbo

# ==========================================
# Google Gemini 配置
# ==========================================
GEMINI_API_KEY=AIzaSy_your_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_MODEL=gemini-1.5-pro

# ==========================================
# DeepSeek 配置
# ==========================================
DEEPSEEK_API_KEY=sk-your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
# 月之暗面 Kimi 配置
# ==========================================
MOONSHOT_API_KEY=sk-your_key_here
MOONSHOT_BASE_URL=https://api.moonshot.cn/
MOONSHOT_MODEL=moonshot-v1-8k

# ==========================================
# 本地 Ollama 配置 (可选)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434/
OLLAMA_MODEL=llama2

# ==========================================
# 默认服务选择
# ==========================================
# 可选值: openai, openai_proxy, gemini, deepseek, moonshot, ollama
DEFAULT_AI_SERVICE=openai

# ==========================================
# 通用设置
# ==========================================
AI_REQUEST_TIMEOUT=300
AI_MAX_RETRIES=3
AI_ENABLE_STREAMING=true
