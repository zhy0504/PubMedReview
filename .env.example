# Copy to .env or save settings in the local Web workbench. Never commit .env.
DEFAULT_AI_SERVICE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# openai = Chat Completions; openai_responses = Responses
OPENAI_API_TYPE=openai

# 自定义 OpenAI 兼容代理：填写服务商要求的完整基础地址
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_BASE_URL=
OPENAI_PROXY_MODEL=
OPENAI_PROXY_API_TYPE=openai

# 直连 DeepSeek 时使用 https://api.deepseek.com，不要追加 /v1；可将 DEFAULT_AI_SERVICE 改为 deepseek。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_TYPE=openai

# 智谱 OpenAI 兼容接口：完整地址包含 /api/paas/v4，不要再追加 /v1。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3
ZHIPU_API_TYPE=openai

# Moonshot / Kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_API_TYPE=openai

# 阿里 DashScope / 通义千问
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_API_TYPE=openai

# 火山方舟 / 豆包
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_ARK_MODEL=doubao-seed-2-0-lite-260215
VOLCENGINE_ARK_API_TYPE=openai

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_API_TYPE=openai

# OpenRouter / Groq / Together / Mistral
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_TYPE=openai
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_TYPE=openai
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_API_TYPE=openai
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_TYPE=openai

# Google Gemini 原生接口
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_TYPE=gemini

# Anthropic Claude 原生 Messages API（模型名称需手动填写）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_TYPE=anthropic

# 本地服务无需 API Key
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_API_TYPE=openai
LMSTUDIO_API_KEY=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_TYPE=openai

PUBMED_API_KEY=
AI_REQUEST_TIMEOUT=300
AI_MAX_RETRIES=3
AI_ENABLE_STREAMING=true
